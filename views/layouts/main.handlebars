<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <style>
    body{font-family:Arial,sans-serif;max-width:900px;margin:30px auto;padding:0 16px}
    table{border-collapse:collapse;width:100%} th,td{border:1px solid #ccc;padding:8px;text-align:left}
    th{background:#f0f0f0} .err{color:#b00020} .ok{color:#0a7d2c}
    footer{margin-top:40px;padding-top:12px;border-top:1px solid #ccc;color:#444}
    input{padding:6px;margin:4px 0;width:100%;box-sizing:border-box}
  </style>
</head>
<body>
  <h1>📚 Quản lý Sách</h1>
  <nav><a href="/">Danh sách</a> | <a href="/add">Thêm sách</a></nav>
  <hr>
  {{#if flash}}<p class="ok">{{flash}}</p>{{/if}}
  {{{body}}}
  <footer>
    {{student.name}} - MSSV: {{student.mssv}} - VAT áp dụng: {{student.vat}}%
  </footer>
</body>
</html>